---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="bg-ink-950 text-stone-300">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,600&family=Fraunces:opsz,wght@9..144,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col items-center justify-center bg-grid-fade px-6 font-sans">
    <h1 class="font-display text-2xl font-semibold text-stone-100">Page not found</h1>
    <p class="mt-3 text-stone-500">That URL doesn’t exist.</p>
    <a
      href="/"
      class="mt-8 rounded-full border border-stone-700 bg-stone-900/50 px-5 py-2 text-sm font-medium text-stone-200 transition hover:border-amber-600/50 hover:text-amber-100"
    >
      Back home
    </a>
  </body>
</html>
